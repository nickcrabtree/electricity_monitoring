  "panels": [
    {
      "datasource": {
        "type": "graphite",
        "uid": "000000001"
      },
      "description": "'unexplained' (left axis) is the whole-house meter reading minus the sum of the monitored plugs (aggregate.power_watts), as a 3-minute median centred on each moment (no time lag; the newest 90 s is drawn once the readings after it arrive) and shown at 0 W when negative.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "watt"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "meter.power_watts"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "last"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "graphite",
            "uid": "000000001"
          },
          "refId": "A",
          "target": "aliasByNode(removeEmptySeries(home.electricity.*.*.power_watts), 3)"
        },
        {
          "datasource": {
            "type": "graphite",
            "uid": "000000001"
          },
          "refId": "B",
          "target": "aliasByNode(removeEmptySeries(home.electricity.meter.power_watts), 2, 3)"
        },
        {
          "datasource": {
            "type": "graphite",
            "uid": "000000001"
          },
          "refId": "C",
          "target": "alias(scale(sumSeries(timeShift(movingMedian(diffSeries(keepLastValue(home.electricity.meter.power_watts, 6), keepLastValue(home.electricity.aggregate.power_watts, 6)), '3min'), '+90s'), absolute(timeShift(movingMedian(diffSeries(keepLastValue(home.electricity.meter.power_watts, 6), keepLastValue(home.electricity.aggregate.power_watts, 6)), '3min'), '+90s'))), 0.5), 'unexplained')"
        }
      ],
